# Copy to .env (git-ignored) and adjust. This file is a template for LOCAL DEVELOPMENT ONLY:
# never put real credentials here, and never reuse these values outside your machine.

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=atlas
# Placeholder: replace it in your .env with a password of your own.
# - Use only letters, digits, "_" or "-": the password is embedded in the URLs below.
# - Use the same value in POSTGRES_PASSWORD, DATABASE_URL and TEST_DATABASE_URL.
# - Postgres applies it only when the data volume is first created; see docs/DEVELOPMENT.md.
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_DB=atlas
POSTGRES_PORT=5433

# --- Backend ---
# Host-run backend connects via localhost; docker-compose overrides this with the `db` host.
DATABASE_URL=postgresql+psycopg://atlas:local_dev_only_change_me@localhost:5433/atlas
# Used by the backend test suite (created by infra/postgres/init on a fresh volume).
TEST_DATABASE_URL=postgresql+psycopg://atlas:local_dev_only_change_me@localhost:5433/atlas_test
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000

# --- Frontend ---
# Server-side base URL the Next.js server uses to reach the API.
API_URL=http://localhost:8000
FRONTEND_PORT=3000
